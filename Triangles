#include <stdio.h>

int main() {
    int a, b, c;

    printf("Enter the lengths of three sides: ");
    scanf("%d %d %d", &a, &b, &c);

    if (a + b > c && a + c > b && b + c > a) {

        if (a == b && b == c) {
            printf("The triangle is an equilateral triangle.");
        }
        else if (a == b || b == c || a == c) {
            printf("The triangle is an isosceles triangle.");
        }
        else {
            printf("The triangle is a scalene triangle.");
        }

    }
    else {
        printf("The sides do not form a valid triangle.");
    }

    return 0;
}